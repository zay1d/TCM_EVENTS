# ── Server ─────────────────────────────────────────────────────────
PORT=8080
# Comma-separated list of allowed frontend origins (Cloudflare Pages URL, custom domain).
# Example: https://tcm-events.pages.dev,https://events.example.com
CORS_ORIGINS=http://localhost:5173

# ── Auth (owner / редактор) ────────────────────────────────────────
# Long random string used to sign JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
# Bcrypt hash of the owner password. Generate with: npm run hash -- "yourPassword"
OWNER_PASSWORD_HASH=

# ── PostgreSQL ─────────────────────────────────────────────────────
DATABASE_URL=postgres://tcm:tcmpassword@localhost:5432/tcm_events

# ── Cloudflare R2 (S3-compatible object storage) ───────────────────
# From the R2 dashboard: account id, an API token (access key/secret), bucket name.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tcm-events-documents
# Endpoint is https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Optional public base URL if the bucket is served via a public domain; leave empty to use presigned download URLs.
R2_PUBLIC_BASE_URL=
